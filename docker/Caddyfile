# The dev UI's own file server inside its image (not the TLS proxy in front of it): the sign-in
# page (/), the debugger (/debugger/) and the world editor (/editor/). Hashed assets are cached
# for good.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	@html not path /assets/*
	header @html Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}
